*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.cmd text eol=crlf

# Keep the imported snapshot and its license texts byte-for-byte.
third_party/moto-gps-waveshare/** -text eol=lf -whitespace

# The generated asset hashes must survive Windows / Unix checkouts.
firmware/assets/boot/*.c text eol=lf
firmware/assets/boot/*.h text eol=lf
firmware/assets/boot/ducati-red-logo.svg -text

# Preserve the original OFL license bytes, including upstream whitespace.
firmware/assets/fonts/OFL.txt -text -whitespace
