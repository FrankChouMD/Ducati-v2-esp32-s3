{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moto-gps.local/schema/route-bundle.v1.schema.json",
  "title": "RouteBundleEnvelopeV1",
  "description": "Versioned route response consumed by both WebAssembly and ESP32 targets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "request_id", "route"],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "request_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295,
      "description": "Exact echo of the request identifier; consumers must ignore a response that is no longer active."
    },
    "route": {
      "$ref": "#/$defs/routeBundle"
    }
  },
  "$defs": {
    "routeBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "route_id",
        "provider",
        "coordinate_system",
        "generated_at_ms",
        "total_distance_m",
        "total_duration_s",
        "polyline",
        "maneuvers",
        "traffic"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "route_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "provider": {
          "const": "amap"
        },
        "coordinate_system": {
          "const": "GCJ-02",
          "description": "Every point in this bundle is GCJ-02. WGS84 GNSS fixes must cross the same explicit transform boundary before matching."
        },
        "generated_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total_distance_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "total_duration_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800
        },
        "polyline": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8192,
          "items": {
            "$ref": "#/$defs/gcj02Point"
          }
        },
        "maneuvers": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/maneuver"
          }
        },
        "traffic": {
          "type": "array",
          "maxItems": 2048,
          "items": {
            "$ref": "#/$defs/trafficSegment"
          }
        },
        "motorcycle_assessment": {
          "$ref": "#/$defs/motorcycleAssessment"
        }
      }
    },
    "gcj02Point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["longitude_deg", "latitude_deg"],
      "properties": {
        "longitude_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "latitude_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      }
    },
    "maneuver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "route_offset_m",
        "road_name",
        "instruction",
        "roundabout_exit"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "type": {
          "enum": [
            "unknown",
            "continue",
            "slight_left",
            "left",
            "sharp_left",
            "u_turn_left",
            "slight_right",
            "right",
            "sharp_right",
            "u_turn_right",
            "roundabout",
            "exit",
            "arrive"
          ]
        },
        "route_offset_m": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000
        },
        "road_name": {
          "type": "string",
          "maxLength": 96
        },
        "instruction": {
          "type": "string",
          "maxLength": 256
        },
        "roundabout_exit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        }
      }
    },
    "trafficSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_offset_m", "end_offset_m", "level"],
      "properties": {
        "start_offset_m": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000
        },
        "end_offset_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "level": {
          "enum": ["unknown", "free_flow", "slow", "congested", "severe"]
        }
      }
    },
    "wgs84Point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate_system",
        "longitude_deg",
        "latitude_deg"
      ],
      "properties": {
        "coordinate_system": {
          "const": "WGS84"
        },
        "longitude_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "latitude_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      }
    },
    "motorcycleOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region",
        "registration",
        "avoid_highways",
        "avoid_tolls",
        "avoid_ferries",
        "avoid_areas",
        "waypoints"
      ],
      "properties": {
        "region": {
          "const": "nanjing"
        },
        "registration": {
          "enum": [
            "nanjing_suburban",
            "nanjing_urban",
            "non_nanjing",
            "unknown"
          ]
        },
        "avoid_highways": {
          "type": "boolean"
        },
        "avoid_tolls": {
          "type": "boolean"
        },
        "avoid_ferries": {
          "type": "boolean"
        },
        "waypoints": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/wgs84Point"
          }
        },
        "avoid_areas": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "points"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "points": {
                "type": "array",
                "minItems": 3,
                "maxItems": 16,
                "items": {
                  "$ref": "#/$defs/wgs84Point"
                }
              }
            }
          }
        }
      }
    },
    "motorcycleRestrictionArea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "source_url", "data_version", "coordinate_system", "applies_to_registration", "polygon"],
      "properties": {
        "id": { "const": "motu-025-10255" },
        "name": { "type": "string", "minLength": 1 },
        "source_url": { "const": "https://www.motumap.com/nodata.js" },
        "data_version": { "type": "string", "pattern": "^motu-025-10255-" },
        "coordinate_system": { "const": "GCJ-02" },
        "applies_to_registration": { "type": "boolean" },
        "polygon": {
          "type": "array",
          "minItems": 3,
          "maxItems": 512,
          "items": { "$ref": "#/$defs/gcj02Point" }
        }
      }
    },
    "motorcycleAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "verified_on",
        "coverage",
        "status",
        "checked_at_ms",
        "applied_options",
        "warnings",
        "sources",
        "restriction_areas",
        "camera_data_status"
      ],
      "properties": {
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "verified_on": {
          "type": "string",
          "format": "date"
        },
        "coverage": {
          "const": "partial"
        },
        "status": {
          "const": "review_required"
        },
        "checked_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "restriction_areas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/motorcycleRestrictionArea" }
        },
        "camera_data_status": { "const": "unavailable" },
        "applied_options": {
          "$ref": "#/$defs/motorcycleOptions"
        },
        "warnings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "url"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      }
    }
  }
}
